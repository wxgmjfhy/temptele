config_version=5

[application]
config/name="3D dependency smoke test"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=128
window/size/viewport_height=96

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
